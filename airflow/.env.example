# Airflow Environment Variables
# Copy this file to .env and fill in your actual values

# Django Settings
DJANGO_SETTINGS_MODULE=restaurant_booking.settings
PYTHONPATH=/path/to/your/project

# Airflow Home
AIRFLOW_HOME=$HOME/airflow

# Airflow Core Settings
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__LOAD_DEFAULT_CONNECTIONS=True
AIRFLOW__CORE__PARALLELISM=32
AIRFLOW__CORE__DAG_CONCURRENCY=16
AIRFLOW__CORE__MAX_ACTIVE_RUNS_PER_DAG=16

# Database Configuration
# PostgreSQL connection string for Airflow metadata
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:password@localhost:5432/airflow

# Django Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=restaurant_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# SMTP Configuration for Email Notifications
AIRFLOW__SMTP__SMTP_HOST=smtp.gmail.com
AIRFLOW__SMTP__SMTP_PORT=587
AIRFLOW__SMTP__SMTP_USER=your-email@gmail.com
AIRFLOW__SMTP__SMTP_PASSWORD=your-app-password
AIRFLOW__SMTP__SMTP_MAIL_FROM=noreply@restaurant.com

# Email Settings
AIRFLOW__EMAIL__EMAIL_BACKEND=airflow.providers.email.backends.smtp.SendEmailBackend
ADMIN_EMAIL=admin@restaurant.com

# Webserver Configuration
AIRFLOW__WEBSERVER__WEB_SERVER_PORT=8080
AIRFLOW__WEBSERVER__WORKERS=4
AIRFLOW__WEBSERVER__AUTHENTICATE=False

# Scheduler Configuration
AIRFLOW__SCHEDULER__DAG_DIR_LIST_INTERVAL=300
AIRFLOW__SCHEDULER__SCHEDULER_INTERVAL=300

# Executor Type (LocalExecutor or CeleryExecutor for production)
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# Logging
AIRFLOW__LOGGING__LOGGING_LEVEL=INFO

# Backup Configuration
BACKUP_RETENTION_DAYS=7
BACKUP_LOCATION=/tmp/airflow/database_backups

# API Configuration
AIRFLOW__API__AUTH_BACKEND=airflow.api.auth.backend.default

# Security
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=True
AIRFLOW__CORE__ENABLE_XCOM_PICKLING=False
